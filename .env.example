# Copy to .env locally. On cPanel, enter these in "Setup Node.js App" → Environment variables instead.
PORT=4000
NODE_ENV=production

# Supabase → Project → Connect → "Session pooler" connection string (Postgres URI, not the REST URL/secret key)
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-secret

# Only needed if the API is on a different domain than the site
CORS_ORIGIN=https://debateos.online

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

RESEND_API_KEY=re_your_resend_api_key
NOTIFICATION_EMAIL=you@example.com

# Claude API key from https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...
# AI speeches + reports each count as one call; this caps calls per user per day (admins are exempt)
AI_DAILY_LIMIT=60
